# Google OAuth 2.0 Client ID (from Google Cloud Console)
# NEVER add GOOGLE_CLIENT_SECRET here — this is a public SPA
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Google Site Verification token (from GCP Branding → Verify your domain).
# Rendered into a <meta name="google-site-verification"> tag in index.html.
# Leave unset until you have a token.
# VITE_GOOGLE_SITE_VERIFICATION=ABCDEFg12345abcdef
